{
  "post_network": {
    "location": "loc_example",
    "display_name": "app",
    "routed": true,
    "subnet": {
      "cidr": "<private-ipv4-cidr>",
      "enable_dhcp": true
    },
    "tags": {
      "env": "prod"
    }
  },
  "post_router": {
    "location": "loc_example",
    "display_name": "private-routing",
    "public_gateway": false,
    "subnet_ids": []
  },
  "create_internet_gateway": {},
  "post_group": {
    "location": "loc_example",
    "display_name": "web-access",
    "template": "web"
  },
  "post_address": {
    "location": "loc_example",
    "tags": {
      "env": "prod",
      "team": "web"
    }
  },
  "post_load_balancer": {
    "location": "loc_example",
    "display_name": "web-lb",
    "subnet_id": "snet_example",
    "offering": "default",
    "listeners": [
      {
        "protocol": "TCP",
        "port": 80,
        "pool": {
          "algorithm": "ROUND_ROBIN",
          "members": [
            {
              "address": "192.0.2.20",
              "port": 8080
            }
          ]
        }
      }
    ]
  },
  "post_volume": {
    "location": "loc_example",
    "display_name": "web-data",
    "size_gb": 20,
    "volume_type": "standard",
    "tags": {
      "env": "prod"
    }
  },
  "snapshot_volume": {
    "display_name": "before-upgrade"
  },
  "create_schedule": {
    "kind": "backup",
    "name": "nightly",
    "target_type": "volume",
    "target_ids": [
      "vol_example"
    ],
    "time_zone": "Asia/Karachi",
    "recurrence": {
      "frequency": "daily",
      "time": "02:00"
    },
    "keep": 7
  },
  "post_server_group": {
    "location": "loc_example",
    "display_name": "web-spread",
    "policy": "anti-affinity"
  },
  "create_template": {
    "name": "web-server",
    "server": {
      "location": "loc_example",
      "display_name": "web",
      "offering": "medium",
      "image": "ubuntu-24-04",
      "network_id": "net_example",
      "ssh_key_id": "ssh_example"
    }
  },
  "create_instance_group": {
    "name": "web",
    "template_id": "ltp_example",
    "template_version": 1,
    "desired": 2,
    "min": 1,
    "max": 4,
    "max_surge": 1
  },
  "create_role": {
    "name": "Deployer",
    "scope": "project",
    "actions": [
      "project.read",
      "workload.read",
      "workload.create",
      "workload.update"
    ]
  },
  "create_service_account": {
    "display_name": "ci-deploy",
    "description": "Deploys web-shop",
    "role": "member"
  },
  "create_invitation": {
    "email": "ayesha@acme.example",
    "role": "member",
    "project_grants": []
  }
}
