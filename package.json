{
  "name": "docs-nubestack-cloud",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "User documentation for NubeStack Cloud: the console, the API and native OpenStack access.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/mkdocs.mjs serve",
    "build": "node scripts/mkdocs.mjs build --strict",
    "preview": "python3 -m http.server 8000 --directory site",
    "check": "python3 scripts/check.py",
    "sync:api": "node scripts/sync-api.mjs",
    "screens": "tsx scripts/screens/take.ts",
    "check:browser": "tsx scripts/check-browser.ts"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  }
}
